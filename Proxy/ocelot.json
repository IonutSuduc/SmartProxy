{
  "Routes": [
    {
      "UpstreamHttpMethod": [ "Get" ],
      "UpstreamPathTemplate": "/{url}",
      "DownstreamPathTemplate": "/{url}",
      "DownstreamScheme": "http",
      "ServiceName": "bookapi",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      },
      "CacheOptions": {
        "TtlSeconds": 15,
        "Region": "books",
        "Header": "OC-Cache-Control",
        "EnableContentHashing": false
      }
    },
    {
      "UpstreamHttpMethod": [ "Post", "Put", "Delete" ],
      "UpstreamPathTemplate": "/{url}",
      "DownstreamPathTemplate": "/{url}",
      "DownstreamScheme": "http",
      "ServiceName": "bookapi",
      "LoadBalancerOptions": {
        "Type": "RoundRobin"
      }
    }
  ],
  "GlobalConfiguration": {
    "ServiceDiscoveryProvider": {
      "Scheme": "http",
      "Host": "consul",
      "Port": 8500,
      "Type": "Consul"
    }
  }
}